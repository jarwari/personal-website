library(dplyr)
library(tidyr)
library(survey)
library(ggplot2)
library(scales)
get_est_col_multi <- function(df, group_vars) {
bad <- c(group_vars, "se", "ci_l", "ci_u", "cv", "deff", "deff_sq", "var")
cand <- setdiff(names(df), bad)
cand <- cand[sapply(df[cand], is.numeric)]
if (length(cand) < 1) stop("Couldn't find estimate column in svyby() output.")
cand[1]
}
sero_long_df <- seroClin %>%
select(
county, age_cat, sex, cluster_uid, hh_uid,
PfCSP_seropositive,
`PfMSP1.19_seropositive`,
`Pv_MSP1.19_No_GPI_seropositive`,
`Pm_MSP1.19_seropositive`,
`Po_MSP1.19_seropositive`
) %>%
pivot_longer(
cols = ends_with("_seropositive"),
names_to = "antigen_raw",
values_to = "serostatus"
) %>%
mutate(
antigen = recode(
antigen_raw,
"PfCSP_seropositive"               = "PfCSP",
"PfMSP1.19_seropositive"           = "PfMSP1-19",
"Pv_MSP1.19_No_GPI_seropositive"   = "PvMSP1-19",
"Pm_MSP1.19_seropositive"          = "PmMSP1-19",
"Po_MSP1.19_seropositive"          = "PoMSP1-19"
),
antigen = factor(antigen, levels = c("PfCSP","PfMSP1-19","PvMSP1-19","PmMSP1-19","PoMSP1-19")),
sex = recode(as.character(sex), `1`="M", `2`="F", "Male"="M", "Female"="F"),
seropos = as.numeric(serostatus == 1)
)
sero_design_long <- svydesign(
id     = ~cluster_uid + hh_uid,
strata = ~county,
data   = sero_long_df %>% filter(!is.na(serostatus)),
nest   = TRUE
)
# age
age_svy <- svyby(
~seropos, ~antigen + age_cat,
design = subset(sero_design_long, !is.na(age_cat)),
FUN = svymean,
na.rm = TRUE,
vartype = "ci"
) %>% as.data.frame()
age_est <- get_est_col_multi(age_svy, c("antigen","age_cat"))
sero_age_prev_svy <- age_svy %>%
transmute(
antigen, age_cat,
seroprev = .data[[age_est]]
)
# (optional but recommended) ensure age_cat is ordered how you want
sero_age_prev_svy <- sero_age_prev_svy %>%
mutate(age_cat = factor(age_cat, levels = c(
"0–5","6–10","11–15","16–19","20–29","30–39","40–49","50+"
)))
ggplot(sero_age_prev_svy, aes(x = age_cat, y = seroprev)) +
geom_col(aes(fill = age_cat)) +
facet_wrap(~ antigen, scales = "fixed") +
scale_y_continuous(labels = percent_format(accuracy = 1)) +
labs(
title = NULL,
x = NULL,                       # remove x-axis title
y = "Seroprevalence (%)",
fill = "Age Categories"         # legend title
) +
theme_minimal(base_size = 14) +
theme(
axis.text.x  = element_blank(), # remove x tick labels (you already had this)
axis.ticks.x = element_blank(),
legend.position = "bottom",
legend.direction = "horizontal"
) +
guides(fill = guide_legend(nrow = 2, byrow = TRUE))
# sex
sex_svy <- svyby(
~seropos, ~antigen + sex,
design = subset(sero_design_long, !is.na(sex)),
FUN = svymean,
na.rm = TRUE,
vartype = "ci"
) %>% as.data.frame()
sex_est <- get_est_col_multi(sex_svy, c("antigen","sex"))
sero_sex_prev_svy <- sex_svy %>%
transmute(
antigen, sex,
seroprev = .data[[sex_est]]
)
ggplot(sero_sex_prev_svy, aes(x = sex, y = seroprev)) +
geom_col(aes(fill = sex)) +
facet_wrap(~ antigen, scales = "fixed") +
scale_y_continuous(labels = percent_format(accuracy = 1)) +
labs(
title = NULL,
x = NULL,
y = "Seroprevalence (%)",
fill = "Sex"
) +
+ scale_x_discrete(labels = c("M" = "Male", "F" = "Female"))
